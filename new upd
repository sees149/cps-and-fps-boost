                position: fixed; top: 12%; left: 50%; transform: translateX(-50%);
                background: rgba(185, 28, 28, 0.90); backdrop-filter: blur(8px);
                border: 2px solid #f87171; border-radius: 12px; padding: 8px 22px;
                color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                font-size: 14px; font-weight: 800; letter-spacing: 0.5px; z-index: 999995;
