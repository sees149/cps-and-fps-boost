// ==UserScript==
// @name         Bloxd.io VIP Engine - Profiles & Smart AFK Edition
// @namespace    http://tampermonkey.net/
// @version      7.0
// @description  Anti-Popup, FPS Boost, 60 HP Uyarısı, YouTube Playlist, Akıllı AFK Tasarruf ve Hazır Profiller.
// @author       Optimizer Pro
// @match        *://bloxd.io/*
// @run-at       document-start
// @noframes
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    // ==========================================
    // 0. ÇOKLU SAYFA & POP-UP KORUMASI
    // ==========================================
    if (window.top !== window.self) return;

    try {
        window.open = function () { return null; };
        Object.freeze(window.open);
    } catch (e) {}

    window.addEventListener('click', function (e) {
        let target = e.target;
        while (target && target.tagName !== 'A') target = target.parentElement;
        if (target && target.tagName === 'A' && target.target === '_blank') {
            e.preventDefault();
            e.stopPropagation();
        }
    }, true);

    // ==========================================
    // 1. GENEL STATE VE AYARLAR
    // ==========================================
    const savedMsg = localStorage.getItem('bloxd_vip_chat_msg') || "gg wp!";

    const defaultPlaylist = [
        { title: "☕ Lofi Girl - Canlı Hip Hop Beats", url: "https://www.youtube.com/watch?v=jfKfPfyJRdk" },
        { title: "🌌 Synthwave Chill - Canlı Radyo", url: "https://www.youtube.com/watch?v=4xDzrJKXOOY" },
        { title: "🔥 TheFatRat - Unity (Gaming)", url: "https://www.youtube.com/watch?v=n8X9_GayFlA" },
        { title: "⚡ Alan Walker - Fade (NCS)", url: "https://www.youtube.com/watch?v=bM7SZ5SBzyY" },
        { title: "🎧 C418 - Wet Hands (Lofi Remix)", url: "https://www.youtube.com/watch?v=HkL8-zG34kM" }
    ];

    let playlist = JSON.parse(localStorage.getItem('bloxd_vip_playlist')) || defaultPlaylist;

    const State = {
        silenceLogs: true,
        pixelated: true,
        removeAds: true,
        showCps: true,
        autoChatEnabled: true,
        autoChatMessage: savedMsg,
        autoChatKey: "KeyG",
        antiMute: true,
        lowHpWarning: true,
        lowHpThreshold: 60,
        smartAfk: true, // Akıllı AFK Tasarruf Modu
        resScale: 1.0,
        fps: 0,
        lmbCps: 0,
        rmbCps: 0
    };

    console.log = () => {}; console.warn = () => {}; console.error = () => {};
    try {
        const origAudioContext = window.AudioContext || window.webkitAudioContext;
        if (origAudioContext) {
            window.AudioContext = function () {
                const ctx = new origAudioContext({ latencyHint: 'interactive' });
                if (ctx.state === 'suspended') ctx.resume();
                return ctx;
            };
        }
    } catch (e) {}

    function applyCanvasOptimizations() {
        document.querySelectorAll('canvas').forEach(canvas => {
            canvas.style.imageRendering = State.pixelated ? 'pixelated' : 'auto';
            if (State.resScale !== 1.0) {
                const rect = canvas.getBoundingClientRect();
                if (rect.width && rect.height) {
                    canvas.width = rect.width * State.resScale;
                    canvas.height = rect.height * State.resScale;
                }
            }
        });
    }

    function removeJunkElements() {
        if (!State.removeAds) return;
        const selectors = [
            'iframe[src*="ad"]', 'iframe[id*="ad"]', 'div[class*="ad-"]', 
            '.adsbygoogle', '#ad-banner', '#preroll', 'div[id*="ad"]'
        ];
        selectors.forEach(sel => {
            document.querySelectorAll(sel).forEach(el => {
                if (el.closest('#opt-menu-container')) return;
                el.remove();
            });
        });
    }
    setInterval(removeJunkElements, 2500);

    // ==========================================
    // 2. AKILLI AFK & DONANIM TASARRUF MOTORU
    // ==========================================
    let isTabSleeping = false;
    document.addEventListener('visibilitychange', () => {
        if (!State.smartAfk) {
            isTabSleeping = false;
            return;
        }
        isTabSleeping = document.hidden;
    });

    // ==========================================
    // 3. CAN (HP) TAKİP & UYARI MOTORU
    // ==========================================
    function getPlayerHealth() {
        const textSelectors = [
            '.HealthBarText', '.healthText', '.HealthText', '.hpText',
            '[class*="HealthBarText"]', '[class*="healthText"]'
        ];
        for (const sel of textSelectors) {
            const el = document.querySelector(sel);
            if (el && el.textContent) {
                const match = el.textContent.match(/(\d+)/);
                if (match) return parseInt(match[1], 10);
            }
        }

        const barSelectors = [
            '.HealthBarInner', '.health-bar-inner', '.HealthBarFill',
            '[class*="HealthBar"] > div', '[class*="health-bar"] > div'
        ];
        for (const sel of barSelectors) {
            const el = document.querySelector(sel);
            if (el && el.style && el.style.width && el.style.width.includes('%')) {
                const w = parseFloat(el.style.width);
                if (!isNaN(w) && w >= 0 && w <= 100) return Math.round(w);
            }
        }

        const candidates = document.querySelectorAll('div, span');
        for (const el of candidates) {
            const rect = el.getBoundingClientRect();
            if (rect.top > window.innerHeight * 0.75 && rect.height > 0 && rect.height < 50) {
                const txt = el.textContent.trim();
                if (/^\d{1,3}\s*\/\s*100$/.test(txt) || (/^\d{1,3}$/.test(txt) && el.className.toLowerCase().includes('health'))) {
                    const val = parseInt(txt, 10);
                    if (!isNaN(val) && val <= 100) return val;
                }
            }
        }
        return null;
    }

    function playWarningBeep() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(650, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(300, ctx.currentTime + 0.25);
            gain.gain.setValueAtTime(0.2, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.26);
        } catch(e) {}
    }

    let wasLowHp = false;
    function checkHealthLoop() {
        if (!State.lowHpWarning) {
            hideHpWarning();
            return;
        }
        const hp = getPlayerHealth();
        if (hp !== null && hp < State.lowHpThreshold && hp > 0) {
            showHpWarning(hp);
            if (!wasLowHp) {
                playWarningBeep();
                wasLowHp = true;
            }
        } else {
            hideHpWarning();
            wasLowHp = false;
        }
    }

    function showHpWarning(currentHp) {
        let vignette = document.getElementById('opt-hp-vignette');
        let banner = document.getElementById('opt-hp-banner');
        if (vignette) vignette.style.display = 'block';
        if (banner) {
            banner.style.display = 'block';
            banner.innerHTML = `⚠️ DİKKAT: CANINIZ KRİTİK! (${currentHp} HP) ⚠️`;
        }
    }

    function hideHpWarning() {
        let vignette = document.getElementById('opt-hp-vignette');
        let banner = document.getElementById('opt-hp-banner');
        if (vignette) vignette.style.display = 'none';
        if (banner) banner.style.display = 'none';
    }
    setInterval(checkHealthLoop, 200);

    // ==========================================
    // 4. 1-10 NOKTA ANTİ-MUTE & CHAT MAKROSU
    // ==========================================
    let antiMuteCycle = 0;
    let lastSendTimestamp = 0;

    function findBloxdChatInput() {
        return document.querySelector('.ChatInput') ||
               document.querySelector('input.ChatInput') ||
               document.querySelector('input[class*="Chat"]') ||
               document.querySelector('#chatInput') ||
               document.querySelector('.chat-input') ||
               document.querySelector('textarea.ChatInput') ||
               document.querySelector('input:not([id^="opt-"]):not([type="checkbox"]):not([type="range"])');
    }

    function sendAutoChatMessage() {
        const inputField = document.getElementById('input-autochat-msg');
        const rawText = inputField ? inputField.value : State.autoChatMessage;
        if (!rawText) return;

        const now = performance.now();
        if (now - lastSendTimestamp < 1000) return;
        lastSendTimestamp = now;

        let textToSend = rawText;
        if (State.antiMute) {
            antiMuteCycle = (antiMuteCycle % 10) + 1;
            textToSend = `${rawText} ${'.'.repeat(antiMuteCycle)}`;
        }

        function submitToInput(inputEl) {
            inputEl.focus();
            const proto = inputEl instanceof HTMLTextAreaElement ? window.HTMLTextAreaElement.prototype : window.HTMLInputElement.prototype;
            const nativeSetter = Object.getOwnPropertyDescriptor(proto, "value")?.set;
            if (nativeSetter) nativeSetter.call(inputEl, textToSend);
            else inputEl.value = textToSend;

            inputEl.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
            inputEl.dispatchEvent(new Event('change', { bubbles: true, composed: true }));

            setTimeout(() => {
                const enterInit = { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true, composed: true };
                inputEl.dispatchEvent(new KeyboardEvent('keydown', enterInit));
                inputEl.dispatchEvent(new KeyboardEvent('keypress', enterInit));
                inputEl.dispatchEvent(new KeyboardEvent('keyup', enterInit));

                if (inputEl.form) inputEl.form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));

                setTimeout(() => {
                    inputEl.blur();
                    const canvas = document.querySelector('canvas');
                    if (canvas) canvas.focus();
                }, 40);
            }, 30);
        }

        let chatInput = findBloxdChatInput();
        if (chatInput) {
            submitToInput(chatInput);
        } else {
            const canvas = document.querySelector('canvas') || document.body;
            canvas.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true }));
            canvas.dispatchEvent(new KeyboardEvent('keyup', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true }));

            setTimeout(() => {
                chatInput = findBloxdChatInput();
                if (chatInput) submitToInput(chatInput);
            }, 60);
        }
    }

    window.addEventListener('keydown', (e) => {
        if (e.target.closest('#opt-menu-container')) return;
        if (e.target.tagName === 'INPUT' && !e.target.classList.contains('ChatInput')) return;
        if (e.target.tagName === 'TEXTAREA' && !e.target.classList.contains('ChatInput')) return;

        if (!State.autoChatEnabled) return;

        const targetKey = State.autoChatKey.toLowerCase();
        const pressedCode = (e.code || '').toLowerCase();
        const pressedKey = (e.key || '').toLowerCase();

        if (pressedCode === targetKey || pressedKey === targetKey.replace('key', '')) {
            e.preventDefault();
            e.stopPropagation();
            sendAutoChatMessage();
        }
    }, true);

    // ==========================================
    // 5. FPS, CPS & AKILLI AFK DÖNGÜSÜ
    // ==========================================
    const lmbClicks = [];
    const rmbClicks = [];

    window.addEventListener('mousedown', (e) => {
        if (e.target.closest('#opt-menu-container') || e.target.closest('#opt-toggle-btn')) return;
        const now = performance.now();
        if (e.button === 0) lmbClicks.push(now);
        if (e.button === 2) rmbClicks.push(now);
    }, true);

    let lastFpsTime = performance.now(), frameCount = 0;
    function mainLoop() {
        // Sekme arkada ve AFK modu açıksa döngüyü 10 FPS'e yavaşlatıp GPU'yu dinlendir
        if (isTabSleeping && State.smartAfk) {
            setTimeout(() => requestAnimationFrame(mainLoop), 100);
            return;
        }

        const now = performance.now();
        frameCount++;
        if (now - lastFpsTime >= 1000) {
            State.fps = frameCount;
            frameCount = 0;
            lastFpsTime = now;
            const fpsEl = document.getElementById('opt-fps-display');
            if (fpsEl) fpsEl.innerText = `${State.fps} FPS`;
        }

        while (lmbClicks.length && lmbClicks[0] <= now - 1000) lmbClicks.shift();
        while (rmbClicks.length && rmbClicks[0] <= now - 1000) rmbClicks.shift();
        State.lmbCps = lmbClicks.length;
        State.rmbCps = rmbClicks.length;

        const lmbDisplay = document.getElementById('cps-lmb');
        const rmbDisplay = document.getElementById('cps-rmb');
        if (lmbDisplay) lmbDisplay.innerText = State.lmbCps;
        if (rmbDisplay) rmbDisplay.innerText = State.rmbCps;

        requestAnimationFrame(mainLoop);
    }
    requestAnimationFrame(mainLoop);

    // ==========================================
    // 6. YOUTUBE OYNATICI
    // ==========================================
    function extractYouTubeId(url) {
        if (!url) return null;
        url = url.trim();
        const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|shorts\/|watch\?v=|watch\?.+&v=))([\w-]{11})/i) ||
                      url.match(/^([\w-]{11})$/);
        return match ? match[1] : null;
    }

    function playYouTubeTrack(url, title) {
        const ytId = extractYouTubeId(url);
        const container = document.getElementById('vip-yt-container');
        const trackDisplay = document.getElementById('audio-track-display');

        if (!ytId) {
            alert("Geçersiz YouTube linki!");
            return;
        }

        if (container) {
            container.innerHTML = `
                <iframe 
                    id="vip-yt-frame" 
                    src="https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&enablejsapi=1&playsinline=1" 
                    style="width: 100%; height: 160px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.15); margin-top: 6px;" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                    allowfullscreen>
                </iframe>
            `;
            if (trackDisplay) trackDisplay.innerHTML = `▶ Çalıyor: <span style="color:#34d399;">${title || 'YouTube Videosu'}</span>`;
        }
    }

    // ==========================================
    // 7. ARAYÜZ & PROFİL MANTIĞI
    // ==========================================
    function applyProfile(type) {
        const toggleLowHp = document.getElementById('toggle-lowhp');
        const toggleCps = document.getElementById('toggle-cps');
        const togglePixel = document.getElementById('toggle-pixel');
        const toggleAutoChat = document.getElementById('toggle-autochat');
        const cpsHud = document.getElementById('opt-cps-hud');
        const menu = document.getElementById('opt-menu-container');

        if (type === 'pvp') {
            State.lowHpWarning = true;
            State.showCps = true;
            State.pixelated = true;
            State.autoChatEnabled = true;
            State.resScale = 1.0;
        } else if (type === 'parkour') {
            State.lowHpWarning = false;
            State.showCps = true;
            State.pixelated = false;
            State.autoChatEnabled = false;
            State.resScale = 1.0;
        } else if (type === 'cinema') {
            State.lowHpWarning = false;
            State.showCps = false;
            State.pixelated = false;
            State.resScale = 1.0;
            menu.classList.add('hidden'); // Menüyü kapatıp ekranı tamamen temizle
        }

        // Arayüz Switch'lerini Güncelle
        if (toggleLowHp) toggleLowHp.checked = State.lowHpWarning;
        if (toggleCps) toggleCps.checked = State.showCps;
        if (togglePixel) togglePixel.checked = State.pixelated;
        if (toggleAutoChat) toggleAutoChat.checked = State.autoChatEnabled;
        if (cpsHud) cpsHud.classList.toggle('hidden', !State.showCps);

        applyCanvasOptimizations();
    }

    function initUI() {
        if (document.getElementById('opt-menu-container')) return;

        const style = document.createElement('style');
        style.innerHTML = `
            #opt-menu-container {
                position: fixed; top: 45px; right: 20px; width: 350px;
