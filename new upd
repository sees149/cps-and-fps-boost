            @keyframes bannerShake { from { transform: translateX(-50%) scale(1); } to { transform: translateX(-50%) scale(1.04); } }

            #opt-cps-hud {
                position: fixed; top: 15px; left: 20px; background: rgba(13, 17, 23, 0.85);
                backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 10px; padding: 6px 14px; display: flex; gap: 10px; font-size: 12px;
                font-weight: 600; color: #fff; z-index: 9999991; user-select: none;
            }
            #opt-cps-hud.hidden { display: none; }
            #opt-toggle-btn {
                position: fixed; bottom: 20px; left: 20px; width: 36px; height: 36px;
                border-radius: 10px; background: rgba(13, 17, 23, 0.75); backdrop-filter: blur(8px);
                border: 1px solid rgba(255, 255, 255, 0.12); display: flex; align-items: center;
                justify-content: center; cursor: pointer; z-index: 9999998;
            }
        `;
        document.head.appendChild(style);

        const hpVignette = document.createElement('div');
        hpVignette.id = 'opt-hp-vignette';
        document.body.appendChild(hpVignette);

        const hpBanner = document.createElement('div');
        hpBanner.id = 'opt-hp-banner';
        document.body.appendChild(hpBanner);

        const cpsHud = document.createElement('div');
        cpsHud.id = 'opt-cps-hud';
        cpsHud.innerHTML = `<div>LMB: <span id="cps-lmb" style="color:#a78bfa;">0</span></div><span style="opacity:0.2;">|</span><div>RMB: <span id="cps-rmb" style="color:#a78bfa;">0</span></div>`;
        document.body.appendChild(cpsHud);

        const menu = document.createElement('div');
        menu.id = 'opt-menu-container';
        menu.innerHTML = `
            <div class="opt-header" id="opt-drag-header">
                <div class="opt-title">⚡ BLOXD VIP ENGINE PRO</div>
                <div class="opt-fps-badge" id="opt-fps-display">-- FPS</div>
            </div>

            <!-- TEK TIKLA HAZIR PROFİLLER -->
            <div class="opt-profiles-bar">
                <button class="opt-profile-btn" id="btn-prof-pvp">⚔️ PvP</button>
                <button class="opt-profile-btn" id="btn-prof-parkour">🏃 Parkur</button>
                <button class="opt-profile-btn" id="btn-prof-cinema">🎬 Sinematik</button>
            </div>

            <div class="opt-tabs">
                <div class="opt-tab-btn active" id="tab-btn-settings">⚙️ Ayarlar & Chat</div>
                <div class="opt-tab-btn" id="tab-btn-music">🎵 YouTube Şarkıları</div>
            </div>

            <!-- 1. SAYFA: AYARLAR -->
            <div class="opt-page" id="page-settings">
                <div class="opt-section-title">🔋 Donanım & Pil Koruması</div>
                <div class="opt-row">
                    <span>Akıllı AFK Modu (Arka Planda 10 FPS)</span>
                    <label class="opt-switch">
                        <input type="checkbox" id="toggle-afk" checked>
                        <span class="opt-slider"></span>
                    </label>
                </div>

                <div class="opt-section-title">🩸 Can & Sağlık Uyarısı</div>
                <div class="opt-row">
                    <span>Düşük Can Uyarısı (< 60 HP)</span>
                    <label class="opt-switch">
                        <input type="checkbox" id="toggle-lowhp" checked>
                        <span class="opt-slider"></span>
                    </label>
                </div>

                <div class="opt-section-title">💬 Otomatik Yazma & Anti-Mute</div>
                <div class="opt-row">
                    <span>Oto Yazma Aktif</span>
                    <label class="opt-switch">
                        <input type="checkbox" id="toggle-autochat" checked>
                        <span class="opt-slider"></span>
                    </label>
                </div>
                <div class="opt-row">
                    <span>Anti-Mute (1-10 Nokta Döngüsü)</span>
                    <label class="opt-switch">
                        <input type="checkbox" id="toggle-antimute" checked>
                        <span class="opt-slider"></span>
                    </label>
                </div>
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <span style="font-size: 11px; color: #8b949e;">Mesajınız:</span>
                    <input type="text" class="opt-input" id="input-autochat-msg" value="${State.autoChatMessage}" placeholder="Mesajınızı buraya yazın...">
                </div>
                <div class="opt-row">
                    <span>Tetikleyici Tuş:</span>
                    <select class="opt-select" id="select-autochat-key">
                        <option value="KeyG" selected>G Tuşu</option>
                        <option value="KeyV">V Tuşu</option>
                        <option value="KeyB">B Tuşu</option>
                        <option value="KeyX">X Tuşu</option>
                        <option value="KeyY">Y Tuşu</option>
                    </select>
                </div>
                <button class="opt-btn" id="btn-test-chat" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">🚀 Test Et (Şimdi Gönder)</button>

                <div class="opt-section-title">⚡ Performans & HUD</div>
                <div class="opt-row">
                    <span>CPS Göstergesi</span>
                    <label class="opt-switch">
                        <input type="checkbox" id="toggle-cps" checked>
                        <span class="opt-slider"></span>
                    </label>
                </div>
                <div class="opt-row">
                    <span>Pixelated Render</span>
                    <label class="opt-switch">
                        <input type="checkbox" id="toggle-pixel" checked>
                        <span class="opt-slider"></span>
                    </label>
                </div>
                <div style="display:flex; flex-direction:column; gap:3px;">
                    <div class="opt-row"><span>Çözünürlük Çarpanı</span><span id="scale-val">1.0x</span></div>
                    <input type="range" class="opt-range" id="scale-slider" min="0.5" max="1.0" step="0.1" value="1.0">
                </div>
            </div>

            <!-- 2. SAYFA: YOUTUBE ÇALMA LİSTESİ -->
            <div class="opt-page hidden" id="page-music">
                <div class="track-info" id="audio-track-display">Şu An: Çalan Şarkı Yok</div>
                <div id="vip-yt-container"></div>

                <div class="opt-section-title">📜 Şarkı Listesi (Tıkla ve Çalsın)</div>
                <div class="playlist-container" id="playlist-list"></div>

                <div class="opt-section-title">➕ Yeni YouTube Şarkısı Ekle</div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <input type="text" class="opt-input" id="new-song-title" placeholder="Şarkı Adı (örn: Phonk Beat)">
                    <input type="text" class="opt-input" id="new-song-url" placeholder="YouTube Linki (örn: https://youtu.be/...)">
                    <button class="opt-btn" id="btn-add-song" style="background: linear-gradient(135deg, #10b981, #059669);">+ Listeye Ekle</button>
                </div>
            </div>
        `;
        document.body.appendChild(menu);

        const floatBtn = document.createElement('div');
        floatBtn.id = 'opt-toggle-btn';
        floatBtn.title = "Menüyü Aç/Kapat";
        floatBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`;
        document.body.appendChild(floatBtn);

        // ==========================================
        // 8. ETKİLEŞİMLER
        // ==========================================
        document.getElementById('btn-prof-pvp').addEventListener('click', () => applyProfile('pvp'));
        document.getElementById('btn-prof-parkour').addEventListener('click', () => applyProfile('parkour'));
        document.getElementById('btn-prof-cinema').addEventListener('click', () => applyProfile('cinema'));

        const tabBtnSettings = document.getElementById('tab-btn-settings');
        const tabBtnMusic = document.getElementById('tab-btn-music');
        const pageSettings = document.getElementById('page-settings');
        const pageMusic = document.getElementById('page-music');

        tabBtnSettings.addEventListener('click', () => {
            tabBtnSettings.classList.add('active');
            tabBtnMusic.classList.remove('active');
            pageSettings.classList.remove('hidden');
            pageMusic.classList.add('hidden');
        });

        tabBtnMusic.addEventListener('click', () => {
            tabBtnMusic.classList.add('active');
            tabBtnSettings.classList.remove('active');
            pageMusic.classList.remove('hidden');
            pageSettings.classList.add('hidden');
        });

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Insert' || e.code === 'ShiftRight') menu.classList.toggle('hidden');
        });
        floatBtn.addEventListener('click', () => menu.classList.toggle('hidden'));

        menu.addEventListener('keydown', (e) => e.stopPropagation());
        menu.addEventListener('keyup', (e) => e.stopPropagation());

        const inputs = menu.querySelectorAll('input[type="text"]');
        inputs.forEach(inp => {
            inp.addEventListener('click', (e) => {
                e.stopPropagation();
                if (document.exitPointerLock) document.exitPointerLock();
                inp.focus();
            });
        });

        // Çalma Listesi Render
        const playlistContainer = document.getElementById('playlist-list');
        function renderPlaylist() {
            playlistContainer.innerHTML = '';
            playlist.forEach((item, index) => {
                const row = document.createElement('div');
                row.className = 'playlist-item';
                row.innerHTML = `
                    <div class="playlist-title">🎵 ${item.title}</div>
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <span style="font-size: 11px; color: #34d399; font-weight: bold;">▶</span>
                        <span class="playlist-del" data-index="${index}" title="Şarkıyı Sil">✕</span>
                    </div>
                `;

                row.addEventListener('click', (e) => {
                    if (e.target.classList.contains('playlist-del')) return;
                    playYouTubeTrack(item.url, item.title);
                });

                row.querySelector('.playlist-del').addEventListener('click', (e) => {
                    e.stopPropagation();
                    playlist.splice(index, 1);
                    localStorage.setItem('bloxd_vip_playlist', JSON.stringify(playlist));
                    renderPlaylist();
                });

                playlistContainer.appendChild(row);
            });
        }
        renderPlaylist();

        document.getElementById('btn-add-song').addEventListener('click', () => {
            const titleInput = document.getElementById('new-song-title');
            const urlInput = document.getElementById('new-song-url');
            const title = titleInput.value.trim();
            const url = urlInput.value.trim();

            if (!title || !url) return alert("Lütfen şarkı adı ve YouTube linki girin!");
            if (!extractYouTubeId(url)) return alert("Geçerli bir YouTube linki girin!");

            playlist.push({ title, url });
            localStorage.setItem('bloxd_vip_playlist', JSON.stringify(playlist));
            renderPlaylist();
            playYouTubeTrack(url, title);

            titleInput.value = '';
            urlInput.value = '';
        });

        // Toggle Dinleyicileri
        document.getElementById('toggle-afk').addEventListener('change', (e) => {
            State.smartAfk = e.target.checked;
        });

        document.getElementById('toggle-lowhp').addEventListener('change', (e) => {
            State.lowHpWarning = e.target.checked;
        });

        const chatInputBox = document.getElementById('input-autochat-msg');
        chatInputBox.addEventListener('input', (e) => {
            State.autoChatMessage = e.target.value;
            localStorage.setItem('bloxd_vip_chat_msg', e.target.value);
        });

        document.getElementById('toggle-autochat').addEventListener('change', (e) => State.autoChatEnabled = e.target.checked);
        document.getElementById('toggle-antimute').addEventListener('change', (e) => State.antiMute = e.target.checked);
        document.getElementById('select-autochat-key').addEventListener('change', (e) => State.autoChatKey = e.target.value);
        document.getElementById('btn-test-chat').addEventListener('click', sendAutoChatMessage);

        document.getElementById('toggle-cps').addEventListener('change', (e) => {
            State.showCps = e.target.checked;
            cpsHud.classList.toggle('hidden', !State.showCps);
        });

        document.getElementById('toggle-pixel').addEventListener('change', (e) => {
            State.pixelated = e.target.checked;
            applyCanvasOptimizations();
        });

        document.getElementById('scale-slider').addEventListener('input', (e) => {
            State.resScale = parseFloat(e.target.value);
            document.getElementById('scale-val').innerText = `${State.resScale.toFixed(1)}x`;
            applyCanvasOptimizations();
        });

        // Sürükleme Mantığı
        const dragHeader = document.getElementById('opt-drag-header');
        let isDragging = false, startX, startY, initX, initY;
        dragHeader.addEventListener('mousedown', (e) => {
            isDragging = true;
            startX = e.clientX; startY = e.clientY;
            const rect = menu.getBoundingClientRect();
            initX = rect.left; initY = rect.top;
        });
        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            menu.style.left = `${initX + (e.clientX - startX)}px`;
            menu.style.top = `${initY + (e.clientY - startY)}px`;
            menu.style.right = 'auto';
        });
        window.addEventListener('mouseup', () => { isDragging = false; });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initUI);
    } else {
        initUI();
    }
})();
