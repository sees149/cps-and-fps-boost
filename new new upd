                <div class="opt-section-title">💬 Oto-Spam & Chat Botu</div>
                <div class="opt-row">
                    <span>Oto-Yazma Anahtarı</span>
                    <label class="opt-switch">
                        <input type="checkbox" id="toggle-autochat" checked>
                        <span class="opt-slider"></span>
                    </label>
                </div>
                <div class="opt-row">
                    <span>Spam Durumu:</span>
                    <span id="spam-status-badge" style="color: #f87171; font-weight:700;">🔴 DURDURULDU</span>
                </div>
                <button class="opt-btn" id="btn-toggle-spam-loop" style="background: linear-gradient(135deg, #10b981, #059669); font-weight:700;">▶ Oto-Spamı Başlat (${State.autoChatKeyName})</button>

                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <span style="font-size: 11px; color: #8b949e;">Mesajınız:</span>
                    <input type="text" class="opt-input" id="input-autochat-msg" value="${State.autoChatMessage}">
                </div>
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <span style="font-size: 11px; color: #8b949e;">Açma/Kapatma Tuşu:</span>
                    <button id="btn-bind-key">⌨️ Tuş: ${State.autoChatKeyName} (Değiştirmek İçin Tıkla)</button>
                </div>
            </div>

            <div class="opt-page hidden" id="page-music">
                <div class="track-info" id="audio-track-display">Şu An: Çalan Şarkı Yok</div>
                <div id="vip-yt-container"></div>
                <div class="playlist-container" id="playlist-list"></div>
                <div style="display: flex; flex-direction: column; gap: 5px; margin-top: 5px;">
                    <input type="text" class="opt-input" id="new-song-title" placeholder="Şarkı Adı">
                    <input type="text" class="opt-input" id="new-song-url" placeholder="YouTube Linki">
                    <button class="opt-btn" id="btn-add-song">+ Listeye Ekle</button>
                </div>
            </div>

            <div class="opt-page hidden" id="page-parkour">
                <div class="opt-section-title">⌨️ Keystrokes (Tuş Takip)</div>
                <div class="opt-row">
                    <span>Keystrokes HUD'ı Göster</span>
                    <label class="opt-switch">
                        <input type="checkbox" id="toggle-keystrokes" checked>
                        <span class="opt-slider"></span>
                    </label>
                </div>
            </div>
        `;
        document.body.appendChild(menu);

        const floatBtn = document.createElement('div');
        floatBtn.id = 'opt-toggle-btn';
        floatBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`;
        document.body.appendChild(floatBtn);

        // ==========================================
        // 8. ETKİLEŞİMLER
        // ==========================================
        const btnBind = document.getElementById('btn-bind-key');
        btnBind.addEventListener('click', (e) => {
            e.stopPropagation();
            if (document.exitPointerLock) document.exitPointerLock();
            isBindingKey = true;
            btnBind.innerText = "⌛ Klavyeden Bir Tuşa Basın...";
            btnBind.style.borderColor = "#f59e0b";
            btnBind.style.color = "#f59e0b";
        });

        document.getElementById('btn-toggle-spam-loop').addEventListener('click', toggleAutoSpamEngine);

        const tabBtnSettings = document.getElementById('tab-btn-settings');
        const tabBtnMusic = document.getElementById('tab-btn-music');
        const tabBtnParkour = document.getElementById('tab-btn-parkour');
        const pageSettings = document.getElementById('page-settings');
        const pageMusic = document.getElementById('page-music');
        const pageParkour = document.getElementById('page-parkour');

        function switchTab(activeBtn, activePage) {
            [tabBtnSettings, tabBtnMusic, tabBtnParkour].forEach(b => b.classList.remove('active'));
            [pageSettings, pageMusic, pageParkour].forEach(p => p.classList.add('hidden'));
            activeBtn.classList.add('active');
            activePage.classList.remove('hidden');
        }

        tabBtnSettings.addEventListener('click', () => switchTab(tabBtnSettings, pageSettings));
        tabBtnMusic.addEventListener('click', () => switchTab(tabBtnMusic, pageMusic));
        tabBtnParkour.addEventListener('click', () => switchTab(tabBtnParkour, pageParkour));

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Insert' || e.code === 'ShiftRight') menu.classList.toggle('hidden');
        });
        floatBtn.addEventListener('click', () => menu.classList.toggle('hidden'));

        menu.addEventListener('keydown', (e) => e.stopPropagation());
        menu.addEventListener('keyup', (e) => e.stopPropagation());

        const inputs = menu.querySelectorAll('input[type="text"]');
        inputs.forEach(inp => {
            inp.addEventListener('click', (e) => {
                e.stopPropagation();
                if (document.exitPointerLock) document.exitPointerLock();
                inp.focus();
            });
        });

        document.getElementById('toggle-keystrokes').addEventListener('change', (e) => {
            State.showKeystrokes = e.target.checked;
            keystrokesHud.classList.toggle('hidden', !State.showKeystrokes);
        });

        document.getElementById('toggle-lowhp').addEventListener('change', (e) => {
            State.lowHpWarning = e.target.checked;
        });

        document.getElementById('toggle-autochat').addEventListener('change', (e) => {
            State.autoChatEnabled = e.target.checked;
            if (!State.autoChatEnabled) stopAutoSpamEngine();
        });

        const chatInputBox = document.getElementById('input-autochat-msg');
        chatInputBox.addEventListener('input', (e) => {
            State.autoChatMessage = e.target.value;
            localStorage.setItem('bloxd_vip_chat_msg', e.target.value);
        });

        // Çalma Listesi
        const playlistContainer = document.getElementById('playlist-list');
        function renderPlaylist() {
            playlistContainer.innerHTML = '';
            playlist.forEach((item, index) => {
                const row = document.createElement('div');
                row.className = 'playlist-item';
                row.innerHTML = `<div class="playlist-title">🎵 ${item.title}</div><span style="color:#34d399; font-weight:bold;">▶</span>`;
                row.addEventListener('click', () => playYouTubeTrack(item.url, item.title));
                playlistContainer.appendChild(row);
            });
        }
        renderPlaylist();

        document.getElementById('btn-add-song').addEventListener('click', () => {
            const title = document.getElementById('new-song-title').value.trim();
            const url = document.getElementById('new-song-url').value.trim();
            if (!title || !url) return alert("Eksik bilgi!");
            playlist.push({ title, url });
            localStorage.setItem('bloxd_vip_playlist', JSON.stringify(playlist));
            renderPlaylist();
            playYouTubeTrack(url, title);
        });

        // Sürükleme
        function makeDraggable(headerEl, targetEl) {
            let isDragging = false, startX, startY, initX, initY;
            headerEl.addEventListener('mousedown', (e) => {
                if (e.target.tagName === 'BUTTON') return;
                isDragging = true;
                startX = e.clientX; startY = e.clientY;
                const rect = targetEl.getBoundingClientRect();
                initX = rect.left; initY = rect.top;
            });
            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                targetEl.style.left = `${initX + (e.clientX - startX)}px`;
                targetEl.style.top = `${initY + (e.clientY - startY)}px`;
                targetEl.style.right = 'auto';
            });
            window.addEventListener('mouseup', () => { isDragging = false; });
        }
        makeDraggable(document.getElementById('opt-drag-header'), menu);
        makeDraggable(keystrokesHud, keystrokesHud);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initUI);
    } else {
        initUI();
    }
})();
