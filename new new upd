// ==UserScript==
// @name         Bloxd.io VIP Engine - 100% Fully Automatic
// @namespace    http://tampermonkey.net/
// @version      13.0
// @description  Tamamen otomatik can takibi, fiziksel renkli bar okuyucu, otomatik 60 HP uyarısı ve 3 sekmeli VIP panel.
// @author       Optimizer Pro
// @match        *://bloxd.io/*
// @run-at       document-start
// @noframes
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    if (window.top !== window.self) return;
    if (window.__bloxdVipCleanup) window.__bloxdVipCleanup();

    try {
        window.open = function () { return null; };
        Object.freeze(window.open);
    } catch (e) {}

    window.addEventListener('click', function (e) {
        let target = e.target;
        while (target && target.tagName !== 'A') target = target.parentElement;
        if (target && target.tagName === 'A' && target.target === '_blank') {
            e.preventDefault();
            e.stopPropagation();
        }
    }, true);

    // ==========================================
    // 1. GENEL STATE VE AYARLAR
    // ==========================================
    const savedMsg = localStorage.getItem('bloxd_vip_chat_msg') || "gg wp!";
    const savedKey = localStorage.getItem('bloxd_vip_chat_key') || "KeyV";
    const savedKeyName = localStorage.getItem('bloxd_vip_chat_key_name') || "V";

    const defaultPlaylist = [
        { title: "☕ Lofi Girl - Canlı Hip Hop Beats", url: "https://www.youtube.com/watch?v=jfKfPfyJRdk" },
        { title: "🌌 Synthwave Chill - Canlı Radyo", url: "https://www.youtube.com/watch?v=4xDzrJKXOOY" },
        { title: "🔥 TheFatRat - Unity (Gaming)", url: "https://www.youtube.com/watch?v=n8X9_GayFlA" },
        { title: "⚡ Alan Walker - Fade (NCS)", url: "https://www.youtube.com/watch?v=bM7SZ5SBzyY" },
        { title: "🎧 C418 - Wet Hands (Lofi Remix)", url: "https://www.youtube.com/watch?v=HkL8-zG34kM" }
    ];

    let playlist = JSON.parse(localStorage.getItem('bloxd_vip_playlist')) || defaultPlaylist;

    const State = {
        silenceLogs: true,
        pixelated: true,
        removeAds: true,
        showCps: true,
        autoChatEnabled: true,
        autoSpamRunning: false,
        autoChatMessage: savedMsg,
        autoChatKey: savedKey,
        autoChatKeyName: savedKeyName,
        antiMute: true,
        spamIntervalMs: 2200,
        showTimer: true,
        timerColor: '#a78bfa',
        timerSize: 18,
        showKeystrokes: true,
        lowHpWarning: true,
        lowHpThreshold: 60,
        currentHp: 100,
        smartAfk: true,
        resScale: 1.0,
        fps: 0,
        lmbCps: 0,
        rmbCps: 0
    };

    let isBindingKey = false;
    console.log = () => {}; console.warn = () => {}; console.error = () => {};

    // ==========================================
    // 2. OTOMATİK FİZİKSEL CAN (HP) MOTORU
    // ==========================================
    function detectRealHealth() {
        const W = window.innerWidth;
        const H = window.innerHeight;

        const isMenu = (el) => {
            return !el || el.closest('#opt-menu-container') ||
                   el.closest('#opt-cps-hud') ||
                   el.closest('#opt-keystrokes-hud') ||
                   el.closest('#opt-timer-hud') ||
                   el.closest('#opt-hp-banner') ||
                   el.closest('#opt-hp-vignette');
        };

        // YÖNTEM A: DİNAMİK METİN TESPİTİ (Örn: "75/100" veya "75 HP")
        const allText = document.querySelectorAll('div, span, p');
        for (let i = 0; i < allText.length; i++) {
            const el = allText[i];
            if (isMenu(el)) continue;
            const rect = el.getBoundingClientRect();
            if (rect.top > H * 0.55 && rect.bottom <= H) {
                const txt = el.textContent ? el.textContent.trim() : '';
                const slashM = txt.match(/^([1-9]\d?|100)\s*\/\s*100$/);
                if (slashM) {
                    const hp = parseInt(slashM[1], 10);
                    if (hp > 0 && hp <= 100) return hp;
                }
                const hpM = txt.match(/^([1-9]\d?|100)\s*hp$/i);
                if (hpM) {
                    const hp = parseInt(hpM[1], 10);
                    if (hp > 0 && hp <= 100) return hp;
                }
            }
        }

        // YÖNTEM B: FİZİKSEL RENKLİ CAN BARI (KIRMIZI / YEŞİL / TURUNCU PİKSEL ORANI)
        // Bloxd.io'da can barı ekranın altındadır ve hasar aldıkça fiziksel pikseli küçülür!
        const allDivs = document.querySelectorAll('div');
        for (let i = 0; i < allDivs.length; i++) {
            const el = allDivs[i];
            if (isMenu(el)) continue;

            const rect = el.getBoundingClientRect();
            // Ekranın alt %40'ında, ortalanmış bir çubuk mu?
            if (rect.top > H * 0.60 && rect.bottom <= H && rect.left > W * 0.08 && rect.right < W * 0.92) {
                if (rect.height >= 3 && rect.height <= 36 && rect.width > 2) {
                    const style = window.getComputedStyle(el);
                    const bg = style.backgroundColor || '';
                    const m = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
                    if (m) {
                        const r = parseInt(m[1], 10);
                        const g = parseInt(m[2], 10);
                        const b = parseInt(m[3], 10);

                        // Kırmızı (Hasarlı Can), Yeşil (Dolu Can) veya Turuncu
                        const isRed = (r > 155 && g < 115 && b < 115);
                        const isGreen = (g > 135 && r < 135);
                        const isOrange = (r > 175 && g > 85 && g < 185 && b < 85);

                        if (isRed || isGreen || isOrange) {
                            // 1. Inline Style Genişliği (%...)
                            const wStr = el.style.width || '';
                            if (wStr.includes('%')) {
                                const val = Math.round(parseFloat(wStr));
                                if (val > 0 && val <= 100) return val;
                            }

                            // 2. Transform ScaleX
                            const transform = el.style.transform || '';
                            const scaleM = transform.match(/scaleX\(([\d.]+)\)/i);
                            if (scaleM) {
                                const s = parseFloat(scaleM[1]);
                                if (s > 0 && s <= 1) return Math.round(s * 100);
                            }

                            // 3. Ebeveyn Kutusuna Göre Gerçek Piksel Oranı (En Kesin Yöntem!)
                            const parent = el.parentElement;
                            if (parent) {
                                const parentRect = parent.getBoundingClientRect();
                                if (parentRect.width >= 40 && parentRect.width <= 500) {
                                    const ratio = Math.round((rect.width / parentRect.width) * 100);
                                    if (ratio > 0 && ratio <= 100) return ratio;
                                }
                            }
                        }
                    }
                }
            }
        }

        return null;
    }

    function playWarningBeep() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(750, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(300, ctx.currentTime + 0.25);
            gain.gain.setValueAtTime(0.3, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.26);
        } catch(e) {}
    }

    let wasLowHp = false;

    // TAMAMEN OTOMATİK CAN VE UYARI DÖNGÜSÜ (100ms HIZINDA)
    function autoHealthLoop() {
        const hp = detectRealHealth();

        if (hp !== null) {
            State.currentHp = hp;
            const liveHpEl = document.getElementById('live-hp-display');
            if (liveHpEl) {
                liveHpEl.innerText = `${hp} HP`;
                liveHpEl.style.color = hp <= 60 ? "#f87171" : "#34d399";
            }
        }

        if (!State.lowHpWarning) {
            hideHpWarning();
            return;
        }

        // CAN 60 VE ALTINA DÜŞTÜĞÜ SALİSE UYAR
        if (State.currentHp !== null && State.currentHp <= State.lowHpThreshold && State.currentHp > 0) {
            showHpWarning(State.currentHp);
            if (!wasLowHp) {
                playWarningBeep();
                wasLowHp = true;
            }
        } else {
            hideHpWarning();
            wasLowHp = false;
        }
    }

    function showHpWarning(currentHp) {
        let vignette = document.getElementById('opt-hp-vignette');
        let banner = document.getElementById('opt-hp-banner');
        if (vignette) vignette.style.display = 'block';
        if (banner) {
            banner.style.display = 'block';
            banner.innerHTML = `⚠️ DİKKAT: CANINIZ DÜŞTÜ! (${currentHp} HP) ⚠️`;
        }
    }

    function hideHpWarning() {
        let vignette = document.getElementById('opt-hp-vignette');
        let banner = document.getElementById('opt-hp-banner');
        if (vignette) vignette.style.display = 'none';
        if (banner) banner.style.display = 'none';
    }
    const hpInterval = setInterval(autoHealthLoop, 100);

    // ==========================================
    // 3. OTO-SPAM & OTOMATİK ENTER
    // ==========================================
    let antiMuteCycle = 0;
    let autoSpamTimer = null;

    function findBloxdChatInput() {
        return document.querySelector('.ChatInput') ||
               document.querySelector('input.ChatInput') ||
               document.querySelector('input[class*="Chat"]') ||
               document.querySelector('#chatInput') ||
               document.querySelector('.chat-input') ||
               document.querySelector('textarea.ChatInput') ||
               document.querySelector('input:not([id^="opt-"]):not([type="checkbox"]):not([type="range"])');
    }

    function sendSingleChatMessage() {
        if (!State.autoChatEnabled) return;
        const inputField = document.getElementById('input-autochat-msg');
        const rawText = inputField ? inputField.value : State.autoChatMessage;
        if (!rawText) return;

        let textToSend = rawText;
        if (State.antiMute) {
            antiMuteCycle = (antiMuteCycle % 10) + 1;
            textToSend = `${rawText} ${'.'.repeat(antiMuteCycle)}`;
        }

        function triggerSubmit(inputEl) {
            inputEl.focus();
            const proto = inputEl instanceof HTMLTextAreaElement ? window.HTMLTextAreaElement.prototype : window.HTMLInputElement.prototype;
            const nativeSetter = Object.getOwnPropertyDescriptor(proto, "value")?.set;
            if (nativeSetter) nativeSetter.call(inputEl, textToSend);
            else inputEl.value = textToSend;

            inputEl.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
            inputEl.dispatchEvent(new Event('change', { bubbles: true, composed: true }));

            setTimeout(() => {
                function makeEnter(type) {
                    const ev = new KeyboardEvent(type, {
                        key: 'Enter', code: 'Enter', keyCode: 13, which: 13,
                        bubbles: true, cancelable: true, composed: true, view: window
                    });
                    Object.defineProperty(ev, 'keyCode', { get: () => 13 });
                    Object.defineProperty(ev, 'which', { get: () => 13 });
                    return ev;
                }

                inputEl.dispatchEvent(makeEnter('keydown'));
                inputEl.dispatchEvent(makeEnter('keypress'));
                inputEl.dispatchEvent(makeEnter('keyup'));

                if (inputEl.form) {
                    try { inputEl.form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true })); } catch(e) {}
                }
                document.dispatchEvent(makeEnter('keydown'));

                setTimeout(() => {
                    const canvas = document.querySelector('canvas');
                    if (canvas && document.activeElement === inputEl) {
                        inputEl.blur();
                        canvas.focus();
                    }
                }, 80);
            }, 50);
        }

        let chatInput = findBloxdChatInput();
        if (chatInput) {
            triggerSubmit(chatInput);
        } else {
            const canvas = document.querySelector('canvas') || document.body;
            const openEv = new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true });
            Object.defineProperty(openEv, 'keyCode', { get: () => 13 });
            Object.defineProperty(openEv, 'which', { get: () => 13 });
            canvas.dispatchEvent(openEv);

            setTimeout(() => {
                chatInput = findBloxdChatInput();
                if (chatInput) triggerSubmit(chatInput);
            }, 70);
        }
    }

    function toggleAutoSpamEngine() {
        if (!State.autoChatEnabled) return alert("Önce Oto-Yazma anahtarını açın!");
        if (State.autoSpamRunning) stopAutoSpamEngine();
        else startAutoSpamEngine();
    }

    function startAutoSpamEngine() {
        State.autoSpamRunning = true;
        sendSingleChatMessage();

        if (autoSpamTimer) clearInterval(autoSpamTimer);
        autoSpamTimer = setInterval(() => {
            if (!State.autoSpamRunning || !State.autoChatEnabled) {
                stopAutoSpamEngine();
                return;
            }
            sendSingleChatMessage();
        }, State.spamIntervalMs);

        updateSpamUIState();
    }

    function stopAutoSpamEngine() {
        State.autoSpamRunning = false;
        if (autoSpamTimer) {
            clearInterval(autoSpamTimer);
            autoSpamTimer = null;
        }
        updateSpamUIState();
    }

    function updateSpamUIState() {
        const btn = document.getElementById('btn-toggle-spam-loop');
        const badge = document.getElementById('spam-status-badge');
        if (!btn || !badge) return;

        if (State.autoSpamRunning) {
            btn.innerText = `⏹ Oto-Spamı Durdur (${State.autoChatKeyName})`;
            btn.style.background = "linear-gradient(135deg, #ef4444, #dc2626)";
            badge.innerText = `🟢 ÇALIŞIYOR (${State.autoChatKeyName} ile durdur)`;
            badge.style.color = "#34d399";
        } else {
            btn.innerText = `▶ Oto-Spamı Başlat (${State.autoChatKeyName})`;
            btn.style.background = "linear-gradient(135deg, #10b981, #059669)";
            badge.innerText = "🔴 DURDURULDU";
            badge.style.color = "#f87171";
        }
    }

    // ==========================================
    // 4. TUŞ DİNLİYİCİSİ
    // ==========================================
    const keysPressed = { KeyW: false, KeyA: false, KeyS: false, KeyD: false, Space: false, LMB: false, RMB: false };

    function updateKeystrokesUI() {
        if (!State.showKeystrokes) return;
        const mapping = { KeyW: 'ks-key-w', KeyA: 'ks-key-a', KeyS: 'ks-key-s', KeyD: 'ks-key-d', Space: 'ks-key-space', LMB: 'ks-key-lmb', RMB: 'ks-key-rmb' };
        for (const [code, id] of Object.entries(mapping)) {
            const el = document.getElementById(id);
            if (el) el.classList.toggle('active', keysPressed[code]);
        }
    }

    const globalKeydownHandler = (e) => {
        if (isBindingKey) {
            e.preventDefault();
            e.stopPropagation();

            State.autoChatKey = e.code;
            State.autoChatKeyName = e.key.length === 1 ? e.key.toUpperCase() : e.code.replace('Key', '').replace('Digit', '');

            localStorage.setItem('bloxd_vip_chat_key', State.autoChatKey);
            localStorage.setItem('bloxd_vip_chat_key_name', State.autoChatKeyName);

            isBindingKey = false;
            const btnBind = document.getElementById('btn-bind-key');
            if (btnBind) {
                btnBind.innerText = `⌨️ Tuş: ${State.autoChatKeyName} (Değiştirmek İçin Tıkla)`;
                btnBind.style.borderColor = '#10b981';
                btnBind.style.color = '#fff';
            }
            updateSpamUIState();
            return;
        }

        if (e.code in keysPressed) {
            keysPressed[e.code] = true;
            updateKeystrokesUI();
        }

        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;

        const targetCode = String(State.autoChatKey).toUpperCase();
        const targetName = String(State.autoChatKeyName).toUpperCase();
        const currentCode = String(e.code || '').toUpperCase();
        const currentKey = String(e.key || '').toUpperCase();

        if (currentCode === targetCode || currentKey === targetName) {
            e.preventDefault();
            e.stopPropagation();
            toggleAutoSpamEngine();
        }
    };
    window.addEventListener('keydown', globalKeydownHandler, true);

    window.addEventListener('keyup', (e) => {
        if (e.code in keysPressed) {
            keysPressed[e.code] = false;
            updateKeystrokesUI();
        }
    }, true);

    window.addEventListener('mousedown', (e) => {
        if (e.target.closest('#opt-menu-container') || e.target.closest('#opt-toggle-btn')) return;
        const now = performance.now();
        if (e.button === 0) { keysPressed.LMB = true; lmbClicks.push(now); }
        if (e.button === 2) { keysPressed.RMB = true; rmbClicks.push(now); }
        updateKeystrokesUI();
    }, true);

    window.addEventListener('mouseup', (e) => {
        if (e.button === 0) keysPressed.LMB = false;
        if (e.button === 2) keysPressed.RMB = false;
        updateKeystrokesUI();
    }, true);

    // ==========================================
    // 5. FPS & CPS DÖNGÜSÜ
    // ==========================================
    const lmbClicks = [];
    const rmbClicks = [];
    let lastFpsTime = performance.now(), frameCount = 0;

    function mainLoop() {
        const now = performance.now();
        frameCount++;
        if (now - lastFpsTime >= 1000) {
            State.fps = frameCount;
            frameCount = 0;
            lastFpsTime = now;
            const fpsEl = document.getElementById('opt-fps-display');
            if (fpsEl) fpsEl.innerText = `${State.fps} FPS`;
        }

        while (lmbClicks.length && lmbClicks[0] <= now - 1000) lmbClicks.shift();
        while (rmbClicks.length && rmbClicks[0] <= now - 1000) rmbClicks.shift();
        State.lmbCps = lmbClicks.length;
        State.rmbCps = rmbClicks.length;

        const lmbDisplay = document.getElementById('cps-lmb');
        const rmbDisplay = document.getElementById('cps-rmb');
        if (lmbDisplay) lmbDisplay.innerText = State.lmbCps;
        if (rmbDisplay) rmbDisplay.innerText = State.rmbCps;

        requestAnimationFrame(mainLoop);
    }
    requestAnimationFrame(mainLoop);

    // ==========================================
    // 6. YOUTUBE OYNATICI
    // ==========================================
    function extractYouTubeId(url) {
        if (!url) return null;
        const match = url.trim().match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|shorts\/|watch\?v=|watch\?.+&v=))([\w-]{11})/i) || url.match(/^([\w-]{11})$/);
        return match ? match[1] : null;
    }

    function playYouTubeTrack(url, title) {
        const ytId = extractYouTubeId(url);
        const container = document.getElementById('vip-yt-container');
        const trackDisplay = document.getElementById('audio-track-display');
        if (!ytId) return alert("Geçersiz link!");

        if (container) {
            container.innerHTML = `
                <iframe id="vip-yt-frame" src="https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&enablejsapi=1&playsinline=1" 
                style="width: 100%; height: 160px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.15); margin-top: 6px;" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
            `;
            if (trackDisplay) trackDisplay.innerHTML = `▶ Çalıyor: <span style="color:#34d399;">${title || 'Müzik'}</span>`;
        }
    }

