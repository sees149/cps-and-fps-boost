                <div class="opt-tab-btn" id="tab-btn-parkour">🏃 Tuşlar</div>
            </div>

            <div class="opt-page" id="page-settings">
                <div class="opt-section-title">🩸 Otomatik Can Takip Motoru</div>
                
                <div class="opt-row" style="background: rgba(0,0,0,0.4); padding: 8px 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08);">
                    <span>🎮 Canlı Can (Otomatik):</span>
                    <span id="live-hp-display" style="font-weight: 800; font-size: 13px; color: #34d399;">100 HP</span>
                </div>

                <div class="opt-row">
                    <span>Düşük Can Uyarısı (< 60 HP)</span>
                    <label class="opt-switch">
                        <input type="checkbox" id="toggle-lowhp" checked>
                        <span class="opt-slider"></span>
                    </label>
