        document.head.appendChild(style);

        const hpVignette = document.createElement('div'); hpVignette.id = 'opt-hp-vignette'; document.body.appendChild(hpVignette);
        const hpBanner = document.createElement('div'); hpBanner.id = 'opt-hp-banner'; document.body.appendChild(hpBanner);
        const cpsHud = document.createElement('div'); cpsHud.id = 'opt-cps-hud'; cpsHud.innerHTML = `<div>LMB: <span id="cps-lmb" style="color:#a78bfa;">0</span></div><span style="opacity:0.2;">|</span><div>RMB: <span id="cps-rmb" style="color:#a78bfa;">0</span></div>`; document.body.appendChild(cpsHud);

        const keystrokesHud = document.createElement('div');
        keystrokesHud.id = 'opt-keystrokes-hud';
        keystrokesHud.innerHTML = `
            <div class="ks-row"><div class="ks-key" id="ks-key-w">W</div></div>
            <div class="ks-row"><div class="ks-key" id="ks-key-a">A</div><div class="ks-key" id="ks-key-s">S</div><div class="ks-key" id="ks-key-d">D</div></div>
