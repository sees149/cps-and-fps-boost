        }
        renderPlaylist();

        document.getElementById('btn-add-song').addEventListener('click', () => {
            const title = document.getElementById('new-song-title').value.trim();
            const url = document.getElementById('new-song-url').value.trim();
            if (!title || !url) return alert("Eksik bilgi!");
            playlist.push({ title, url });
            localStorage.setItem('bloxd_vip_playlist', JSON.stringify(playlist));
            renderPlaylist();
            playYouTubeTrack(url, title);
        });

        // Sürükleme
        function makeDraggable(headerEl, targetEl) {
            let isDragging = false, startX, startY, initX, initY;
            headerEl.addEventListener('mousedown', (e) => {
                if (e.target.tagName === 'BUTTON') return;
                isDragging = true;
                startX = e.clientX; startY = e.clientY;
                const rect = targetEl.getBoundingClientRect();
                initX = rect.left; initY = rect.top;
            });
            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                targetEl.style.left = `${initX + (e.clientX - startX)}px`;
                targetEl.style.top = `${initY + (e.clientY - startY)}px`;
                targetEl.style.right = 'auto';
            });
            window.addEventListener('mouseup', () => { isDragging = false; });
        }
        makeDraggable(document.getElementById('opt-drag-header'), menu);
        makeDraggable(keystrokesHud, keystrokesHud);
        makeDraggable(timerHud, timerHud);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initUI);
    } else {
        initUI();
    }
})();
